@{
    ViewData["Title"] = "Stories";
}

<section class="hero">
    <div>
        <p class="eyebrow">Ideas on making and learning</p>
        <h1>Notes from the work in progress.</h1>
    </div>
    <p class="hero-intro">A quiet collection of sample essays about building useful software, designing with care, and learning by shipping.</p>
</section>

<section class="featured" aria-labelledby="featured-title">
    <div class="featured-copy">
        <p class="post-meta"><span>Featured</span> · 6 min read</p>
        <h2 id="featured-title">Build the smallest version that can teach you something</h2>
        <p>Good side projects begin with one useful question. A compact first release makes the answer visible, creates momentum, and gives every later feature a reason to exist.</p>
        <span class="read-label">Sample article <span aria-hidden="true">↗</span></span>
    </div>
    <div class="featured-art" role="img" aria-label="Abstract paper layers representing an idea taking shape">
        <span></span><span></span><span></span>
    </div>
</section>

<section class="latest" aria-labelledby="latest-title">
    <div class="section-heading">
        <p class="eyebrow">Latest notes</p>
        <h2 id="latest-title">Three ideas worth keeping</h2>
    </div>
    <div class="post-grid">
        <article class="post-card">
            <p class="post-index">01</p>
            <p class="post-meta">Design · 4 min read</p>
            <h3>Designing for quiet focus</h3>
            <p>Clarity often comes from deciding what the page can leave out—not what else it can hold.</p>
            <span class="read-label">Sample article</span>
        </article>
        <article class="post-card post-card--accent">
            <p class="post-index">02</p>
            <p class="post-meta">Development · 5 min read</p>
            <h3>The useful discipline of clear boundaries</h3>
            <p>Small components, explicit routes, and honest project scope make software easier to explain and extend.</p>
            <span class="read-label">Sample article</span>
        </article>
        <article class="post-card">
            <p class="post-index">03</p>
            <p class="post-meta">Learning · 3 min read</p>
            <h3>What changes after you ship</h3>
            <p>A finished first version replaces guesses with feedback and turns a private exercise into a public record of growth.</p>
            <span class="read-label">Sample article</span>
        </article>
    </div>
    <p class="scope-note"><strong>Portfolio note:</strong> these entries are static demonstration content. Post storage, editing, authentication, and comments are not implemented yet.</p>
</section>
