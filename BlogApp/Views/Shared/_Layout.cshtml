<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Fieldnotes is a clean ASP.NET Core MVC blog showcase built with Razor views." />
    <meta name="theme-color" content="#17231d" />
    <title>@ViewData["Title"] — Fieldnotes</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
        <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Fieldnotes home">
            <span class="brand-mark" aria-hidden="true">F</span>
            <span>Fieldnotes</span>
        </a>
        <nav aria-label="Primary navigation">
            <a asp-area="" asp-controller="Home" asp-action="Index">Stories</a>
            <a asp-area="" asp-controller="Home" asp-action="About">About</a>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </nav>
    </header>

    <main id="content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div>
            <a class="brand brand--footer" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">F</span>
                <span>Fieldnotes</span>
            </a>
            <p>A small MVC publishing showcase.</p>
        </div>
        <p>&copy; @DateTime.UtcNow.Year Fieldnotes · <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></p>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
