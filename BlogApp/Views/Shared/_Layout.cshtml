<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["Description"] ?? "Thoughtful stories about software, design, and learning. Explore the Fieldnotes journal.")" />
    <meta name="theme-color" content="#17231d" />
    <title>@ViewData["Title"] — Fieldnotes</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
        <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Fieldnotes home">
            <span class="brand-mark" aria-hidden="true">F</span>
            <span>Fieldnotes</span>
        </a>
        <nav aria-label="Primary navigation">
            <a asp-area="" asp-controller="Home" asp-action="Index" aria-current="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "page" : null)">Stories</a>
            <a asp-area="" asp-controller="Home" asp-action="About" aria-current="@(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "page" : null)">About</a>
            <a asp-area="" asp-controller="Home" asp-action="Privacy" aria-current="@(ViewContext.RouteData.Values["action"]?.ToString() == "Privacy" ? "page" : null)">Privacy</a>
        </nav>
    </header>

    <main id="content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div>
            <a class="brand brand--footer" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">F</span>
                <span>Fieldnotes</span>
            </a>
            <p>A journal for curious builders.</p>
        </div>
        <p>&copy; @DateTime.UtcNow.Year Fieldnotes · <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></p>
    </footer>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
